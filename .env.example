# Local: SQLite y proveedor IA simulado. No contiene secretos.
APP_ENV=local
DATABASE_URL=sqlite:///./outputs/lab06.db
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173
AUTH_REQUIRED=false

# Produccion: Entra ID para usuarios y Managed Identity para servicios Azure.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=api://<api-app-client-id>
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_REQUIRED_SCOPE=Lab.Access

# Azure OpenAI. AZURE_OPENAI_API_KEY es solo fallback local; en Azure use identidad.
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
# La integracion usa el endpoint Azure OpenAI v1; se conserva por compatibilidad.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# Storage privado y observabilidad (sin SAS ni claves permanentes).
AZURE_STORAGE_ACCOUNT_URL=https://<cuenta>.blob.core.windows.net
APPLICATIONINSIGHTS_CONNECTION_STRING=
